{
  "name": "@flamboyan/web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "build:checked": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:source": "npm audit",
    "audit:runtime": "npm audit --prefix .output/server --omit=dev"
  },
  "dependencies": {
    "@vercel/oidc": "4.0.9",
    "laravel-echo": "^2.5.0",
    "nuxt": "4.6.4",
    "pusher-js": "^8.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "archiver": {
      "readdir-glob": {
        "minimatch": "11.0.5"
      }
    }
  }
}

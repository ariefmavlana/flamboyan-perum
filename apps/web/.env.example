NUXT_API_BASE=http://127.0.0.1:8000
NUXT_API_PROXY_SECRET=
# Hanya preview Vercel terproteksi: identitas OIDC runtime, tanpa secret statis.
# Tetap kosong pada lokal/Hostinger/produksi. Tidak pernah memakai NUXT_PUBLIC_*.
NUXT_API_PREVIEW_OIDC=false
NUXT_API_PREVIEW_HOST=
NUXT_TRUSTED_PROXY_IPS=
NUXT_ALLOWED_HOSTS=localhost,127.0.0.1
NUXT_TOUR_HOSTS=my.matterport.com
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Digit internasional tanpa +; kosong menyembunyikan CTA.
NUXT_PUBLIC_WHATSAPP_NUMBER=6282214795024
NUXT_PUBLIC_ANALYTICS_ENABLED=false

# Opsional. Kosong berarti tidak ada skrip pihak ketiga dimuat dan tidak ada
# banner persetujuan tampil. Nilai diisi hanya setelah akun resmi tersedia.
NUXT_PUBLIC_GTM_ID=
# Meta Pixel langsung; kosongkan bila Meta Pixel dikonfigurasi di dalam
# container GTM agar PageView tidak terhitung ganda.
NUXT_PUBLIC_META_PIXEL_ID=
# Aktifkan hanya jika container GTM benar-benar memuat Meta; membuka host CSP,
# bukan memuat pixel langsung atau memberi persetujuan marketing.
NUXT_PUBLIC_META_VIA_GTM=false
# Penyimpanan UTM first-party memerlukan keputusan kategori opsional.
NUXT_PUBLIC_ATTRIBUTION_ENABLED=false
# Preview memakai false; produksi berdomain final diverifikasi sebelum true.
NUXT_PUBLIC_INDEXABLE=true
# Tautan Instagram resmi; kosong menyembunyikan tautan di footer.
NUXT_PUBLIC_INSTAGRAM_URL=
# GA4, Google Ads, dan Meta dikonfigurasi di dalam container GTM, bukan di
# aplikasi. Simpan ID-nya sebagai catatan konfigurasi, jangan dimuat di sini:
# NUXT_PUBLIC_GA4_ID=
# NUXT_PUBLIC_GOOGLE_ADS_ID=
